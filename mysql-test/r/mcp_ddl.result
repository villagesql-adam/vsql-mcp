INSTALL EXTENSION vsql_mcp;
CREATE USER mcpuser@'127.0.0.1';
GRANT SELECT, SHOW VIEW ON *.* TO mcpuser@'127.0.0.1';
CREATE SCHEMA mcpsec;
GRANT INSERT, UPDATE, DELETE ON mcpsec.* TO mcpuser@'127.0.0.1';
CREATE TABLE mcpsec.t1 (id INT PRIMARY KEY, name VARCHAR(50));
INSERT INTO mcpsec.t1 VALUES (1, 'alpha'), (2, 'beta'), (3, 'gamma');
CREATE TABLE mcpsec.secret (id INT PRIMARY KEY, password_hash VARCHAR(80), KEY ix_ph (password_hash));
INSERT INTO mcpsec.secret VALUES (1, 'hunter2hash');
CREATE SCHEMA mcpalt;
CREATE TABLE mcpalt.t1 (id INT PRIMARY KEY, tag VARCHAR(30));
INSERT INTO mcpalt.t1 VALUES (1, 'other-schema-row');
CREATE VIEW mcpsec.v_leak AS SELECT id, tag FROM mcpalt.t1;
CREATE VIEW mcpsec.v_secret AS SELECT password_hash FROM mcpsec.secret;
SET GLOBAL vsql_mcp.port = 0;
SET GLOBAL vsql_mcp.vsql_mcp_enabled = ON;
GRANT CREATE, ALTER, DROP, INDEX, CREATE TEMPORARY TABLES ON mcpsec.* TO mcpuser@'127.0.0.1';
off_hidden: PASS
off_refused: PASS
SET GLOBAL vsql_mcp.allow_ddl = ON;
on_listed: PASS
create_table: PASS
alter_table: PASS
create_index: PASS
create_unique_index: PASS
drop_index: PASS
rename_table: PASS
create_temporary: PASS
leading_comment: PASS
drop_table: PASS
refuse_drop_database: PASS
refuse_create_database: PASS
refuse_create_user: PASS
refuse_grant: PASS
refuse_create_view: PASS
refuse_create_procedure: PASS
refuse_truncate: PASS
refuse_insert: PASS
refuse_select: PASS
refuse_two_statements: PASS
refuse_comment_between_words: PASS
refuse_version_comment: PASS
refuse_inner_version_comment: PASS
refuse_dash_comment_quote: PASS
refuse_hash_comment_quote: PASS
refuse_discard_tablespace: PASS
refuse_import_tablespace: PASS
refuse_system_tablespace: PASS
refuse_backslash_quote: PASS
grants_apply: PASS
SHOW CREATE TABLE mcpsec.d2;
Table	Create Table
d2	CREATE TABLE `d2` (
  `id` int NOT NULL,
  `name` varchar(20) DEFAULT NULL,
  PRIMARY KEY (`id`),
  UNIQUE KEY `ux_name` (`name`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
# The tables the refused statements name are unchanged.
SELECT TABLE_NAME FROM information_schema.TABLES
WHERE TABLE_SCHEMA IN ('mcpsec', 'mcpalt') ORDER BY TABLE_SCHEMA, TABLE_NAME;
TABLE_NAME
t1
d2
secret
t1
v_leak
v_secret
SET GLOBAL vsql_mcp.schema = 'mcpsec';
schema_decoy_created: PASS
schema_alter_other: PASS
schema_rename_out: PASS
schema_foreign_key: PASS
schema_decoy_drop: PASS
schema_decoy_rename: PASS
schema_decoy_select: PASS
schema_rename_comment: PASS
schema_double_quotes: PASS
schema_inside_runs: PASS
SET GLOBAL vsql_mcp.schema = '';
SET GLOBAL vsql_mcp.allowed_tables = 't1';
allowlist_hidden: PASS
allowlist_refused: PASS
SET GLOBAL vsql_mcp.allowed_tables = '';
SELECT TABLE_NAME FROM information_schema.TABLES
WHERE TABLE_SCHEMA IN ('mcpsec', 'mcpalt') ORDER BY TABLE_SCHEMA, TABLE_NAME;
TABLE_NAME
t1
secret
t1
v_leak
v_secret
SET GLOBAL vsql_mcp.vsql_mcp_enabled = OFF;
SET GLOBAL vsql_mcp.schema = '';
SET GLOBAL vsql_mcp.allowed_tables = '';
SET GLOBAL vsql_mcp.allow_write = OFF;
SET GLOBAL vsql_mcp.allow_ddl = OFF;
SET GLOBAL vsql_mcp.require_auth = OFF;
SET GLOBAL vsql_mcp.bearer_token = '';
SET GLOBAL vsql_mcp.max_rows = 1000;
SET GLOBAL vsql_mcp.query_timeout = 30;
SET GLOBAL vsql_mcp.session_ttl = 1800;
SET GLOBAL vsql_mcp.db_url = '';
SET GLOBAL vsql_mcp.ssl_cert = '';
SET GLOBAL vsql_mcp.ssl_key = '';
SET GLOBAL vsql_mcp.ssl_port = 3143;
DROP VIEW mcpsec.v_secret;
DROP VIEW mcpsec.v_leak;
DROP SCHEMA mcpalt;
DROP SCHEMA mcpsec;
DROP USER mcpuser@'127.0.0.1';
UNINSTALL EXTENSION vsql_mcp;
